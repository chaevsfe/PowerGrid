{
  "type": "create:sequenced_assembly",
  "ingredient": "powergrid:circuit_schematic",
  "loops": 2,
  "sequence": [
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "powergrid:empty_circuit",
      "results": [
        "$result"
      ]
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "create:dough",
      "results": [
        "$result"
      ]
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "#c:plates/copper",
      "results": [
        "$result"
      ]
    },
    {
      "type": "create:pressing",
      "ingredient": "$ingredient",
      "results": [
        "$result"
      ]
    }
  ],
  "transitional_item": {
    "id": "powergrid:incomplete_unetched_circuit"
  },
  "result": {
    "chance": 1.0,
    "id": "powergrid:unetched_circuit"
  }
}
