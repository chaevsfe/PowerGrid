{
  "schemaVersion": 1,
  "id": "powergrid",
  "version": "${version}",
  "name": "Create Fly: Power Grid",
  "description": "Create: Power Grid port for Create Fly 26.2. Physics-based electricity simulation for Create.",
  "authors": [
    "patryk3211",
    "Da-Negy",
    "rvndm",
    "casvara",
    "chaevsfe"
  ],
  "contributors": [
    "chaevsfe"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/create-fly-power-grid",
    "sources": "https://github.com/chaevsfe/PowerGrid",
    "issues": "https://github.com/chaevsfe/PowerGrid/issues",
    "upstream": "https://modrinth.com/mod/power-grid"
  },
  "license": [
    "Apache-2.0"
  ],
  "icon": "assets/powergrid/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.patryk3211.powergrid.fabric.PowerGridFabric"
    ],
    "client": [
      "org.patryk3211.powergrid.fabric.PowerGridClientFabric"
    ],
    "create_plugin": [
      "org.patryk3211.powergrid.fabric.PowerGridCreatePlugin"
    ],
    "createreiviewer": [
      "org.patryk3211.powergrid.compat.viewer.PowerGridViewerPlugin"
    ],
    "createreiviewer_client": [
      "org.patryk3211.powergrid.compat.viewer.PowerGridViewerClientPlugin"
    ],
    "rei_client": [
      "org.patryk3211.powergrid.compat.rei.PowerGridReiClientPlugin"
    ]
  },
  "accessWidener": "powergrid.accesswidener",
  "mixins": [
    "powergrid.mixins.json",
    {
      "config": "powergrid.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "minecraft": "${minecraft_dependency_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "create": "${create_fabric_version_range}",
    "java": ">=25"
  },
  "suggests": {
    "createaddition": "*",
    "createreiviewer": "*",
    "roughlyenoughitems": "*",
    "jei": "*"
  },
  "breaks": {
    "sable": "*",
    "sable-companion": "*"
  }
}
